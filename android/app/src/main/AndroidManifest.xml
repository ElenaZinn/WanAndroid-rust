<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required before the Rust core can open any socket; without it the process is
         denied the `inet` supplementary group and connect() fails with EPERM. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:theme="@style/Theme.WanAndroidRust"
        android:label="WanAndroid Rust">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
